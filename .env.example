# Replace every value before using in production.
APP_SECRET_KEY=replace-with-a-long-random-key
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=replace-this-password
APP_DATABASE_URL=sqlite:////data/sanflow.db
APP_DEFAULT_DRY_RUN=true
APP_LOG_LEVEL=INFO
APP_ANSIBLE_PLAYBOOK=/app/playbooks/brocade_zoning.yml
APP_ANSIBLE_TIMEOUT=600
APP_PPDM_DISCOVERY_TIMEOUT=180
APP_PPDM_DISCOVERY_INTERVAL=10
